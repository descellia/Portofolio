# Public URL of the deployed site, used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://descellia.vercel.app

# Optional. Formspree form ID (the part after https://formspree.io/f/).
# If set, the contact form sends messages directly. If empty, it opens the visitor's email app instead.
NEXT_PUBLIC_FORMSPREE_ID=
